# Copy to .env.jam-agents in the repository root (git-ignored) and fill in the account.
# demo/jam-agents.sh loads it automatically; real environment variables take precedence.

# Required: Band app directory of the account the agents belong to.
JAM_CONFIG_DIR=$HOME/.jam

# Optional: account profile inside that directory (Band's default is `default`).
# JAM_PROFILE=default

# Optional: Band service URL, passed through to the band CLI.
# JAM_BAND_URL=https://app.band.ai

# Optional: handle owner; detected with `band whoami` when unset.
# JAM_AGENT_OWNER=your-handle

# Optional: default action (ensure | check | cleanup). CLI flags override it.
# JAM_AGENTS_ACTION=ensure

# Optional: per-agent overrides of demo/jam-agents.conf, for example:
# manager_MODEL=gpt-5.6-sol
# qa_EFFORT=high
